{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>keroway/.github"],
  packageRules: [
    // リポジトリ固有の追加ルールはここに追記する。実例:
    // - cargo（Rust）を使うリポジトリ: matchManagers: ["cargo"] のグルーピングルールを追加
    //   （keroway/code-tactics, keroway/timeline-dsl の renovate.json(5) を参照）
    // - Astro / フレームワーク本体のような lockstep 依存: groupName で束ねる
    //   （keroway/astro-blog の astrojs グループを参照）
    // - major を自動更新させたくない依存: matchPackageNames + matchUpdateTypes: ["major"] + enabled: false
  ],
}
